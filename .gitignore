# stack.env hører ikke til modellen: Portainer skriver den ikke for
# Git-stacks, variablerne sættes på stacken, og lint-reglen `env-fil` afviser
# en committet stack.env eller .env. Ignoreringen værner mod et uheld.
stack.env

